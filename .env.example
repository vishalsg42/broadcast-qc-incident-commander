# copy to .env and fill in
HACKATHON_ACCOUNT=vishalsg42@gmail.com
HACKATHON_PROJECT=
GCP_REGION=us-central1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Grafana ---------------------------------------------------------------
# TWO separate credentials are needed, and they fail in different ways.
# Creating only the first is the common mistake: queries work, but there is
# nothing to query, because ingestion was never authenticated.
#
# Verify both with: python scripts/check_grafana.py

# 1. QUERYING Loki/Tempo + writing annotations and IRM incidents.
#    A STACK service account token (Administration > Users and access >
#    Service accounts), role Editor. NOT a Cloud Access Policy token.
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# 2. SHIPPING telemetry INTO Grafana Cloud, via the OTLP gateway.
#    Connections > Add new connection > OpenTelemetry (OTLP).
#    The OTel SDK reads these env vars directly - no code change needed.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
#    QUOTE this one. The value contains a space, and an unquoted .env line is
#    truncated by the shell at "Basic", so the credential is silently dropped
#    and the gateway answers "no credentials provided" - which reads as a bad
#    token rather than a quoting bug.
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64(instanceID:token)>"

# Datasource UIDs. Local otel-lgtm uses loki/tempo; Grafana Cloud generates
# stack-specific ones, so a Cloud move is a REMAP, not a URL swap.
# check_grafana.py prints the real values for your stack.
GRAFANA_LOKI_UID=loki
GRAFANA_TEMPO_UID=tempo
