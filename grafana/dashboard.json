{
  "title": "Broadcast QC - delivery attribution",
  "uid": "qc-incident-commander",
  "tags": [
    "qc",
    "delivery",
    "broadcast"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "One delivery",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Leave empty to see everything. Paste a delivery id to follow one."
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "A video file passes through three steps: **receive it**, **fix the volume**, **wrap it for delivery**. The audio is measured after every step. If the finished file is out of spec it is rejected.\n\nThis dashboard answers the question that comes next: **which setting produced the bad file, and who changed it.**\n\nRead top to bottom. The last two tables are the answer; everything above them is the evidence."
      }
    },
    {
      "type": "stat",
      "title": "Files rejected",
      "description": "Steps the gate refused in this time range.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short",
          "displayName": "rejected"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"qc-pipeline\"} | qc_verdict = `BLOCKED` [$__range]))",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Checks run",
      "description": "Every measurement taken. Three per delivery.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "short",
          "displayName": "checks"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum(count_over_time({service_name=\"qc-pipeline\"} | qc_stage != `` [$__range]))",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "How loud each step left the audio",
      "description": "Target is -23 LUFS. A file drifting up toward -17 is too loud and gets rejected. The step where the value jumps is the step that broke it.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "points",
            "pointSize": 7,
            "showPoints": "always",
            "axisLabel": "LUFS"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "avg_over_time({service_name=\"qc-pipeline\"} | qc_stage != `` | unwrap qc_integrated_lufs [$__auto]) by (qc_stage)",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Every check, newest first",
      "description": "One line per step: result, asset, which step, how loud, and which setting produced it.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{service_name=\"qc-pipeline\"} | qc_stage != `` | qc_run_id =~ `$run_id.*` | line_format `{{.qc_verdict}}  {{.qc_asset_id}}  step={{.qc_stage}}  {{.qc_integrated_lufs}} LUFS  setting={{.qc_preset_id}} v{{.qc_preset_version}}` | keep service_name",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "table",
      "title": "Which setting ran, and who changed it",
      "description": "The answer. Every step, the setting it used, and the change record behind that setting.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ name =~ \"stage.*\" } | select(.qc.stage, .qc.preset_id, .qc.preset_version, .qc.preset_changed_by, .qc.preset_change_ticket, .qc.preset_approved_by)",
          "limit": 50,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "Trace Service": true,
              "Trace Name": true,
              "Name": true,
              "Duration": true
            },
            "renameByName": {
              "Span ID": "Open trace",
              "Start time": "When",
              "qc.stage": "Step",
              "qc.preset_id": "Setting",
              "qc.preset_version": "Version",
              "qc.preset_changed_by": "Changed by",
              "qc.preset_change_ticket": "Ticket",
              "qc.preset_approved_by": "Approved by"
            },
            "indexByName": {
              "Start time": 0,
              "qc.stage": 1,
              "qc.preset_id": 2,
              "qc.preset_version": 3,
              "qc.preset_changed_by": 4,
              "qc.preset_change_ticket": 5,
              "qc.preset_approved_by": 6,
              "Span ID": 7
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent deliveries - click a trace id to see the whole journey",
      "description": "One row per delivery attempt. Opening a trace shows all three steps, each carrying the setting that produced it.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "queryType": "traceql",
          "query": "{ name = \"delivery.run\" } | select(.qc.run_id, .qc.asset_id)",
          "limit": 30,
          "tableType": "spans"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "Trace Service": true,
              "Trace Name": true,
              "Name": true,
              "qc.source_path": true
            },
            "renameByName": {
              "Span ID": "Open trace",
              "Start time": "When",
              "qc.asset_id": "Asset",
              "qc.run_id": "Delivery id",
              "Duration": "Took"
            },
            "indexByName": {
              "Start time": 0,
              "qc.asset_id": 1,
              "qc.run_id": 2,
              "Duration": 3,
              "Span ID": 4
            }
          }
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Repairs written back",
        "enable": true,
        "iconColor": "red",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "qc"
          ],
          "limit": 100
        },
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      }
    ]
  }
}
